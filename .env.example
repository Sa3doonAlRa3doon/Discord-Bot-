# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: use a test server ID to register commands instantly while developing.
DISCORD_GUILD_ID=

# Optional: Hatclanker posts public greetings here when members join.
WELCOME_CHANNEL_ID=

# Optional: send /suggest submissions to one dedicated channel.
# If blank, suggestions are posted in the channel where the command is used.
SUGGESTIONS_CHANNEL_ID=

# Optional v3 channels and roles
MOD_LOG_CHANNEL_ID=
APPLICATION_CHANNEL_ID=
TICKET_CATEGORY_ID=
VERIFIED_ROLE_ID=
GOODBYE_CHANNEL_ID=
MEMBER_COUNT_CHANNEL_ID=
BIRTHDAY_CHANNEL_ID=
CONFESSION_CHANNEL_ID=
FREE_GAMES_CHANNEL_ID=

# Optional comma-separated channel IDs to auto-lock during a detected raid
RAID_LOCKDOWN_CHANNEL_IDS=

# Optional local/provider integrations
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
WEBHOOK_SECRET=

# v4 productivity channels and two-way integration bridge
WRITING_PROMPT_CHANNEL_ID=
WRITING_PROMPT_HOUR=8
CALENDAR_CHANNEL_ID=
GOOGLE_CALENDAR_BRIDGE_URL=
KANBAN_BRIDGE_URL=
# JSON mapping, e.g. {"✅":"done","🔄":"doing","📥":"backlog"}
KANBAN_REACTION_MAP={}
INTEGRATION_BRIDGE_TOKEN=

# v4 AI/media provider adapters. Keep blank to disable that command safely.
MEDIA_API_TOKEN=
IMAGE_GENERATION_API_URL=
TRANSCRIPTION_API_URL=
TTS_API_URL=
TTS_DEFAULT_VOICE=default
UPSCALER_API_URL=
BACKGROUND_REMOVAL_API_URL=
FACE_SWAP_API_URL=
FLIGHT_TRACKING_API_URL=
FLIGHT_TRACKING_API_TOKEN=
URBAN_DICTIONARY_API_URL=https://api.urbandictionary.com/v0/define

# v4 server utilities
# JSON array of clean custom status strings
BOT_STATUS_MESSAGES=["/start • server guide","/pomodoro • focus together","/pet • shared mascot"]
STATUS_ROTATION_SECONDS=60
# Honeypot is refused unless this is a dedicated quarantine/unverified role.
HONEYPOT_EXPOSED_ROLE_ID=
# JSON array of 2+ HTTPS images; changes are rate-limited to 6+ hours.
GUILD_ICON_URLS=[]
GUILD_ICON_ROTATION_HOURS=24
